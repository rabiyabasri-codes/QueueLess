<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".activities.ChatbotActivity">

    <!-- Premium App Bar Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorPrimaryDark"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="QueueLess Support"
            app:subtitle="Help Desk &amp; FAQs"
            app:titleTextColor="@android:color/white"
            app:subtitleTextColor="@color/colorBadgeBackground" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Message Recycler View -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="8dp"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbars="vertical"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/layoutQuickQueries"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appBarLayout"
        tools:listitem="@layout/item_chat_bot" />

    <!-- Predefined Quick Queries (Vertical List) -->
    <ScrollView
        android:id="@+id/layoutQuickQueries"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:scrollbars="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:background="@color/colorBackground"
        app:layout_constraintBottom_toTopOf="@+id/cardTypingIndicator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/btnQuery1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:background="@drawable/bg_badge"
                android:clickable="true"
                android:focusable="true"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:text="❓ How to join a queue?"
                android:textColor="@color/colorBadgeText"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnQuery2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:background="@drawable/bg_badge"
                android:clickable="true"
                android:focusable="true"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:text="❓ How does live wait time work?"
                android:textColor="@color/colorBadgeText"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnQuery3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:background="@drawable/bg_badge"
                android:clickable="true"
                android:focusable="true"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:text="❓ Can I order food and pay?"
                android:textColor="@color/colorBadgeText"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnQuery4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:background="@drawable/bg_badge"
                android:clickable="true"
                android:focusable="true"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:text="❓ How do I scan a QR code?"
                android:textColor="@color/colorBadgeText"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnQuery5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:background="@drawable/bg_badge"
                android:clickable="true"
                android:focusable="true"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:text="❓ What are the Admin features?"
                android:textColor="@color/colorBadgeText"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>


    <!-- Typing Indicator Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTypingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/white"
        app:strokeColor="@color/colorDivider"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toTopOf="@+id/layoutInputArea"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTypingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QueueLess is typing..."
                android:textColor="@color/colorPrimary"
                android:textSize="13sp"
                android:textStyle="italic" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Premium Bottom Input Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutInputArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorBackground"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="@color/colorDivider"
            app:strokeWidth="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnSend"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <EditText
                android:id="@+id/etMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:background="@null"
                android:hint="Ask about queues, menus, wait times..."
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:textColor="@color/colorTextPrimary"
                android:textColorHint="@color/colorTextHint"
                android:textSize="15sp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Circular Send FAB Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Send Message"
            app:backgroundTint="@color/colorPrimary"
            app:fabSize="mini"
            app:srcCompat="@drawable/ic_send"
            app:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
